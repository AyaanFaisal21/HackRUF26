# Copy to .env. Nothing here is secret in the example.
DATABASE_URL=postgresql://dayzero:dayzero@localhost:5433/dayzero
# Tiger Cloud: paste the service URL from console.cloud.timescale.com instead of the local one above.
# Model: put ONE key here. Whichever is present is used (LLM_PROVIDER=anthropic|openai forces one).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-4.1
# oracle = read documents from the answer key (offline demo, no key needed). model = call the model above.
SOURCED_READER=oracle
