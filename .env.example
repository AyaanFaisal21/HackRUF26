# Copy to .env. Nothing here is secret in the example.
DATABASE_URL=postgresql://dayzero:dayzero@localhost:5433/dayzero
# Tiger Cloud: paste the service URL from console.cloud.timescale.com instead of the local one above.
ANTHROPIC_API_KEY=
DAYZERO_MODEL=claude-opus-5-5
# oracle = use the answer key as the extractor (offline demo). claude = call the model.
DAYZERO_EXTRACTOR=oracle
